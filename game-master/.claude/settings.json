{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(python3 engine/roll.py *)",
      "Bash(python3 engine/game.py *)",
      "Edit(/games/**)"
    ],
    "deny": [
      "Edit(/games/*/rolls.log)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/engine/game.py\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/engine/game.py\" hook prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/engine/game.py\" hook pre-compact",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/engine/game.py\" statusline"
  }
}
